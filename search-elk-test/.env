# BMS Elasticsearch Configuration
# إعدادات Elasticsearch لمكتبة BMS

# Server Configuration
PORT=3001
NODE_ENV=development

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Database Configuration (for data indexing)
DB_HOST=145.223.98.97
DB_PORT=3306
DB_DATABASE=bms
DB_USERNAME=bms
DB_PASSWORD=bms2025

# Search Configuration
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=100
SEARCH_MIN_QUERY_LENGTH=2

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bms-search.log

# CORS Configuration
CORS_ORIGIN=*

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=1000